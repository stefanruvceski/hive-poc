<?xml version="1.0" encoding="utf-8"?>
<!-- Health module: its permissions, widgets, notification actions and tile. Merged into the app's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sunday reminder to review next week's plan. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rest timer buzz at the end of a rest. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Health Connect: read daily health data, write strength workouts. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- The coach without an API key hands its prompt to the Claude app. -->
        <package android:name="com.anthropic.claude" />
    </queries>

    <application>
        <!-- The coach notification's "Ask Claude" button: opens the Claude app with the prompt (no screen). -->
        <activity
            android:name="app.stride.coach.CoachShare$AskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Share → "Hive Coach": Claude's reply becomes the week's coach review (no screen). -->
        <activity
            android:name="app.stride.coach.CoachShare$ReplyActivity"
            android:exported="true"
            android:label="Hive Coach"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Health Connect privacy note on Android 14+. -->
        <activity-alias
            android:name="app.stride.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="app.stride.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name="app.stride.live.LiveWorkoutReceiver"
            android:exported="false" />

        <service
            android:name="app.stride.live.StartWorkoutTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_hive"
            android:label="Start workout"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="app.stride.widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="Health · Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today" />
        </receiver>

        <receiver
            android:name="app.stride.widget.WeightWidgetReceiver"
            android:exported="true"
            android:label="Health · Weight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weight" />
        </receiver>

        <receiver
            android:name="app.stride.widget.WeekStripWidgetReceiver"
            android:exported="true"
            android:label="Health · Week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_strip" />
        </receiver>

        <receiver
            android:name="app.stride.widget.RingsWidgetReceiver"
            android:exported="true"
            android:label="Health · Daily rings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rings" />
        </receiver>

        <receiver
            android:name="app.stride.widget.RecoveryWidgetReceiver"
            android:exported="true"
            android:label="Health · Recovery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recovery" />
        </receiver>

        <receiver
            android:name="app.stride.widget.NextWorkoutWidgetReceiver"
            android:exported="true"
            android:label="Health · Next workout">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next" />
        </receiver>

        <receiver
            android:name="app.stride.widget.MonthWidgetReceiver"
            android:exported="true"
            android:label="Health · Month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month" />
        </receiver>

        <receiver
            android:name="app.stride.widget.StrengthWidgetReceiver"
            android:exported="true"
            android:label="Health · Strength">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strength" />
        </receiver>

        <receiver
            android:name="app.stride.widget.TotalsWidgetReceiver"
            android:exported="true"
            android:label="Health · Week totals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_totals" />
        </receiver>

        <receiver
            android:name="app.stride.widget.WeightChartWidgetReceiver"
            android:exported="true"
            android:label="Health · Weight trend">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weight_chart" />
        </receiver>

        <receiver
            android:name="app.stride.widget.WeekListWidgetReceiver"
            android:exported="true"
            android:label="Health · Week plan">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_list" />
        </receiver>

        <receiver
            android:name="app.stride.widget.StartWorkoutWidgetReceiver"
            android:exported="true"
            android:label="Health · Start workout">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_start" />
        </receiver>

        <receiver
            android:name="app.stride.widget.LastRunWidgetReceiver"
            android:exported="true"
            android:label="Health · Last run">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_last_run" />
        </receiver>

        <receiver
            android:name="app.stride.widget.LastSwimWidgetReceiver"
            android:exported="true"
            android:label="Health · Last swim">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_last_swim" />
        </receiver>

        <receiver
            android:name="app.stride.widget.StreakWidgetReceiver"
            android:exported="true"
            android:label="Health · Streak">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak" />
        </receiver>
    </application>
</manifest>
