<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: hand downloaded release APKs to the package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Sunday reminder to review next week's plan. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rest timer buzz at the end of a rest. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Health Connect: read daily health data, write strength workouts. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Stride"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stride">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect shows Stride's privacy note from here (Android 13 and older). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Health Connect privacy note on Android 14+. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".live.LiveWorkoutReceiver"
            android:exported="false" />

        <service
            android:name=".live.StartWorkoutTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_stride"
            android:label="Start workout"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="Stride · Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today" />
        </receiver>

        <receiver
            android:name=".widget.WeightWidgetReceiver"
            android:exported="true"
            android:label="Stride · Weight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weight" />
        </receiver>

        <receiver
            android:name=".widget.WeekStripWidgetReceiver"
            android:exported="true"
            android:label="Stride · Week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_strip" />
        </receiver>

        <receiver
            android:name=".widget.RingsWidgetReceiver"
            android:exported="true"
            android:label="Stride · Weekly targets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rings" />
        </receiver>

        <receiver
            android:name=".widget.RecoveryWidgetReceiver"
            android:exported="true"
            android:label="Stride · Recovery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recovery" />
        </receiver>

        <receiver
            android:name=".widget.NextWorkoutWidgetReceiver"
            android:exported="true"
            android:label="Stride · Next workout">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next" />
        </receiver>

        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:exported="true"
            android:label="Stride · Month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month" />
        </receiver>

        <receiver
            android:name=".widget.StrengthWidgetReceiver"
            android:exported="true"
            android:label="Stride · Strength">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strength" />
        </receiver>

        <receiver
            android:name=".widget.TotalsWidgetReceiver"
            android:exported="true"
            android:label="Stride · Week totals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_totals" />
        </receiver>

        <receiver
            android:name=".widget.WeightChartWidgetReceiver"
            android:exported="true"
            android:label="Stride · Weight trend">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weight_chart" />
        </receiver>

        <receiver
            android:name=".widget.WeekListWidgetReceiver"
            android:exported="true"
            android:label="Stride · Week plan">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_list" />
        </receiver>

        <receiver
            android:name=".widget.StartWorkoutWidgetReceiver"
            android:exported="true"
            android:label="Stride · Start workout">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_start" />
        </receiver>

        <receiver
            android:name=".widget.LastRunWidgetReceiver"
            android:exported="true"
            android:label="Stride · Last run">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_last_run" />
        </receiver>

        <receiver
            android:name=".widget.LastSwimWidgetReceiver"
            android:exported="true"
            android:label="Stride · Last swim">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_last_swim" />
        </receiver>

        <receiver
            android:name=".widget.StreakWidgetReceiver"
            android:exported="true"
            android:label="Stride · Streak">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
