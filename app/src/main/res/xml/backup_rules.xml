<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Android 11 and older): keep the Garmin sign-in token and the API keys off backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="garmin.xml" />
    <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="sharedpref" path="wallet_secrets.xml" />
        <exclude domain="sharedpref" path="invest_secrets.xml" />
</full-backup-content>
