<?xml version="1.0" encoding="utf-8"?>
<!-- Wallet module: receipts are read from suf.purs.gov.rs; the barcode scanners and text recognition come with
     Google Play services. Its cards widget and Quick Settings tile. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Download the scanner and text models with the app, so the first scan doesn't wait for them. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode,barcode_ui,ocr" />

        <!-- Share a receipt's QR code (a picture) or its link: it's saved like a scan. -->
        <activity
            android:name="app.stride.wallet.ui.ReceiptShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Hive Receipt"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name="app.stride.wallet.widget.CardsWidgetReceiver"
            android:exported="true"
            android:label="Wallet · Cards">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wallet_widget_cards" />
        </receiver>

        <service
            android:name="app.stride.wallet.widget.CardsTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_hive"
            android:label="Cards"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
