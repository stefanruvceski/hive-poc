<?xml version="1.0" encoding="utf-8"?>
<!-- Stride mark: a bold "S" drawn as one stride, emerald to cyan, with speed lines and a pink pace dot.
     Everything sits inside the 66dp adaptive-icon safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- speed lines -->
    <path
        android:pathData="M27,49 L34,49 M24,57 L33,57 M28,65 L34,65"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeColor="#8034D399" />
    <!-- the S -->
    <path
        android:pathData="M71,38 C67,32.5 61,30.5 54.5,31 C46,31.6 40.5,36.5 41.5,43 C42.6,50 51,52 58,54.5 C65.5,57 70.5,60.5 69.5,67.5 C68.5,74.5 61.5,78.5 53,78 C46,77.6 41,74.5 38,70"
        android:strokeWidth="9.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40" android:startY="30"
                android:endX="70" android:endY="80"
                android:startColor="#FF6EE7B7"
                android:endColor="#FF22D3EE" />
        </aapt:attr>
    </path>
    <!-- pace dot -->
    <path
        android:pathData="M76.5,31.5 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFF472B6" />
</vector>
