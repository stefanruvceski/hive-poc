<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device transfer, without the Garmin sign-in token or the API keys. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="garmin.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="sharedpref" path="wallet_secrets.xml" />
        <exclude domain="sharedpref" path="invest_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="garmin.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="sharedpref" path="wallet_secrets.xml" />
        <exclude domain="sharedpref" path="invest_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
